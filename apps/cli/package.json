{
  "name": "project-memory-manager",
  "version": "1.0.0",
  "description": "Git-native project memory and documentation drift tracker.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/lDiKl/Project_Memory_Manager#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lDiKl/Project_Memory_Manager.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/lDiKl/Project_Memory_Manager/issues"
  },
  "keywords": [
    "documentation",
    "docs",
    "git",
    "cli",
    "mcp",
    "ai",
    "llm",
    "context",
    "project-memory"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "pmem": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "templates",
    "scripts"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check src",
    "prepack": "node scripts/prepack.mjs",
    "postpack": "node scripts/postpack.mjs"
  },
  "dependencies": {
    "@pmem/core": "workspace:*",
    "@pmem/shared-types": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "prompts": "^2.4.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/prompts": "^2.4.9",
    "tsup": "^8.3.0"
  }
}
