{
  "name": "project-memory-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Git-native project memory and documentation drift tracker",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.12.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" --filter \"./apps/*\" run build",
    "dev": "pnpm -r --parallel run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check apps packages",
    "typecheck": "tsc --build packages/shared-types packages/core apps/cli",
    "clean": "pnpm -r exec rm -rf dist node_modules .turbo",
    "validate": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.2",
    "vitest": "^3.2.4"
  }
}
